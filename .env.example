SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InVvYW54cnlheXJ0eXVkdmd6YWpsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTQ5MjUxMjUsImV4cCI6MjExMDUwMTEyNX0.uB-e8LpTvx3PukD_s_TvDudKjAACpbTOautFm8IUy9w

# --------------------------------------------------------------------
# 2. SUPABASE SECRET SERVICE ROLE KEY (ACTION REQUIRED BY USER)
# --------------------------------------------------------------------
# Copy your secret service role key from your Supabase dashboard:
# https://supabase.com/dashboard/project/uoanxryayrtyudvgzajl/settings/api
# NEVER expose this key to the browser or frontend!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# --------------------------------------------------------------------
# 3. APP & FEATURE FLAGS
# --------------------------------------------------------------------
# When enabled, allows location testing without physical GPS check
VITE_ENABLE_DEMO_MODE=true
ALLOW_DEMO_MODE=true

# Backend Server Port & Environment
PORT=4000
NODE_ENV=development

# --------------------------------------------------------------------
# 4. AI LIFE COACH CONFIGURATION (ACTION REQUIRED: Choose one or more)
# --------------------------------------------------------------------
# Active Provider: "groq" (Fastest, ~400 tok/s) | "gemini" | "openrouter" | "anthropic" | "ollama"
COPILOT_AI_PROVIDER=groq

# Option A: Groq Cloud (Recommended for speed & low latency)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Option B: Google Gemini (Free Tier available)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Option C: OpenRouter (Multi-model aggregator)
# Get a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Option D: Anthropic Claude (Optional)
# Get a key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
COACH_MODEL=claude-3-haiku-20240307

# Option E: Local Ollama (Completely offline, no key needed)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b

# --------------------------------------------------------------------
# NOTE ON FALLBACK:
# If no AI keys are provided, the Life Coach automatically runs on
# the calibrated rule-based offline experiment fallback engine.
# --------------------------------------------------------------------
